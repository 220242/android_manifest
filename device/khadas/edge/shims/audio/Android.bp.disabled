// NOT BUILT. The file is named Android.bp.disabled on purpose: Soong globs for
// files named exactly "Android.bp", so this one is invisible to it.
//
// Soong resolves dependencies for every module it parses, whether or not the
// module is installed, and an unknown name is a hard error that stops the whole
// tree. Two of the names below are guesses:
//
//   android.hardware.audio.common-V?-ndk
//   android.media.audio.common.types-V?-ndk
//
// The versioned suffix comes from the frozen aidl_api directory of each package,
// and neither has been read off the tree yet - the module probe now dumps them.
// android.hardware.audio.core-V2-ndk is confirmed (aidl_api/.../2 is frozen),
// and libaudioserviceexampleimpl is confirmed to exist.
//
// Rename back to Android.bp once the two suffixes are filled in from the probe
// and createOutputStream in RkAudioModule.cpp is implemented.
//
// AIDL android.hardware.audio.core service for the Khadas Edge1.
//
// Builds on AOSP's reference implementation in
// hardware/interfaces/audio/aidl/default rather than reimplementing IModule.
//
// NOTE: this module does NOT build yet. createOutputStream in
// RkAudioModule.cpp is unimplemented, and the AOSP library names below
// ("libaudioserviceexampleimpl", the -V2-ndk variants) must be confirmed
// against the synced tree.
//
// It is therefore not in PRODUCT_PACKAGES by default: device.mk gates it behind
// EDGE1_ENABLE_INCOMPLETE_HALS so a tree-wide build reaches the end instead of
// stopping on a gap that is already documented.
//
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.audio.service.rk3399",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.audio.service.rk3399.rc"],
    vintf_fragments: ["android.hardware.audio.service.rk3399.xml"],

    srcs: [
        "RkAudioModule.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "android.hardware.audio.core-V2-ndk",
        "android.hardware.audio.common-V2-ndk",
        "android.media.audio.common.types-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libfmq",
        "libhardware",
        "liblog",
        "libutils",
    ],

    static_libs: [
        // AOSP's subclassable core: Module, StreamIn/StreamOut, Configuration.
        "libaudioserviceexampleimpl",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
}
