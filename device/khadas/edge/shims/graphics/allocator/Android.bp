//
// AIDL android.hardware.graphics.allocator-V2 service for the Khadas Edge1.
//

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.rk3399",
    relative_install_path: "hw",
    // vendor: true, not vendor_available: this links the Rockchip gralloc0
    // module, which is not a VNDK library and may only be loaded from /vendor.
    vendor: true,
    // Installs the .rc into /vendor/etc/init and the VINTF fragment into
    // /vendor/etc/vintf/manifest, which is how Android 14 declares a HAL
    // service. The Android 10 tree hand-wrote both into
    // device/rockchip/common/init.rockchip.rc and a vendor-supplied manifest.
    init_rc: ["android.hardware.graphics.allocator-service.rk3399.rc"],
    vintf_fragments: ["android.hardware.graphics.allocator-service.rk3399.xml"],

    srcs: [
        "RkAllocator.cpp",
        "service.cpp",
    ],

    shared_libs: [
        // The versioned suffix is what Soong generates from the frozen
        // aidl_api directory, and getting it wrong is not a compile error but an
        // analysis error - "depends on undefined module" - which stops the whole
        // tree, including a build that never installs this module.
        // hardware/interfaces/graphics/allocator/aidl/aidl_api/.../2 is frozen in
        // this release, so -V2-ndk exists.
        //
        // android.hardware.graphics.common is deliberately not listed: the
        // allocator interface already depends on it and re-exports its headers,
        // and pinning a version here would be a second guess to get wrong.
        "android.hardware.graphics.allocator-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
    ],

    static_libs: [
        // Provides ::android::dupToAidl for native_handle_t -> NativeHandle.
        "libaidlcommonsupport",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
}
