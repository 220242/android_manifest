<?xml version="1.0" encoding="utf-8"?>
<!--
  Khadas Edge1 (RK3399) - audio policy for an Android TV device, read by the AIDL
  audio HAL (android.hardware.audio.service-aidl.example).

  That HAL builds its modules from this file: every <module> becomes an
  IModule/<name> service ("primary" is registered as "default"), and a file it
  cannot parse gives no modules at all. That is what the tenth card ran into: the
  HAL logged 'Invalid XML config file: "/vendor/etc/audio_policy_configuration.xml"',
  never registered IModule/default, audioserver waited for it forever, and
  system_server's AudioService waited for audioserver until the watchdog killed it
  (67s, three times). The old file was in the HIDL 5/6 format (comma-separated
  lists, profile names, halVersion "AIDL" where the schema allows 2.0 or 3.0) and
  pulled four more files in with xi:include - from AOSP modules whose install
  location this tree does not control, and an include that does not resolve fails
  the whole file.

  So this file is self-contained - no xi:include - and valid against the HAL's own
  schema (hardware/interfaces/audio/aidl/default/config/audioPolicy/
  audio_policy_configuration.xsd, copied to build/schema/ and checked by
  build/verify-tree.sh). The r_submix and bluetooth modules and the volume tables
  are AOSP's, inlined (frameworks/av/services/audiopolicy/config).

  The modules are exactly the IModule instances the HAL's APEX declares in VINTF
  (android.hardware.audio.service-aidl.xml): default, r_submix, bluetooth.
  audioserver waits for every declared instance, and the HAL only creates the
  modules this file names - so with no bluetooth module here, card 13's audioserver
  waited for IModule/bluetooth forever ("Waited one second for
  android.hardware.audio.core.IModule/bluetooth"), media.audio_policy never came up,
  and system_server's AudioService hung until the watchdog. The bluetooth module
  needs no Bluetooth stack to start: it only logs if the BT audio provider is
  missing. usb is out: the APEX does not declare IModule/usb, so servicemanager
  would refuse to register it anyway.

  The primary module's one output is called "Speaker", and it is the HDMI output.
  The HAL allows only built-in devices - an AIDL device type with no connection - in
  <attachedDevices>, and its primary module (ModulePrimary) cannot connect external
  ones at all: it does not implement populateConnectedDevicePort. An attached "HDMI
  Out" made the HAL abort at start ("<attachedDevices> list is incorrect or devicePort
  "HDMI Out" type= ...connection: hdmi... is incorrect", card 12, 129 times). Whatever
  the device is called, the primary module's streams play to ALSA card 0, device 0
  (primary/StreamPrimary.cpp), and on this board card 0 is hdmi-sound, its only card -
  so a built-in "Speaker" is the HDMI output, the way AOSP's TV example
  (primary_audio_policy_configuration_tv.xml) declares it. A real AUDIO_DEVICE_OUT_HDMI,
  with hotplug, S/PDIF and IEC61937 passthrough, needs a HAL module that can connect
  external devices - HAL work, see docs/HAL_MIGRATION.md.
-->
<audioPolicyConfiguration version="7.0">
    <globalConfiguration speaker_drc_enabled="false" call_screen_mode_supported="false"/>
    <modules>
        <module name="primary" halVersion="3.0">
            <attachedDevices>
                <item>Speaker</item>
            </attachedDevices>
            <defaultOutputDevice>Speaker</defaultOutputDevice>
            <mixPorts>
                <mixPort name="primary output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100 48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </mixPort>
            </mixPorts>
            <devicePorts>
                <devicePort tagName="Speaker" type="AUDIO_DEVICE_OUT_SPEAKER" role="sink">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100 48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
            </devicePorts>
            <routes>
                <route type="mix" sink="Speaker" sources="primary output"/>
            </routes>
        </module>
        <module name="r_submix" halVersion="2.0">
                <attachedDevices>
                    <item>Remote Submix In</item>
                </attachedDevices>
                <mixPorts>
                    <mixPort name="r_submix output" role="source">
                        <profile format="AUDIO_FORMAT_PCM_16_BIT"
                                 samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                    </mixPort>
                    <mixPort name="r_submix input" role="sink">
                       <profile format="AUDIO_FORMAT_PCM_16_BIT"
                                samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
                    </mixPort>
               </mixPorts>
               <devicePorts>
                   <devicePort tagName="Remote Submix Out" type="AUDIO_DEVICE_OUT_REMOTE_SUBMIX"  role="sink">
                       <profile format="AUDIO_FORMAT_PCM_16_BIT"
                                samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                   </devicePort>
                   <devicePort tagName="Remote Submix In" type="AUDIO_DEVICE_IN_REMOTE_SUBMIX"  role="source">
                       <profile format="AUDIO_FORMAT_PCM_16_BIT"
                                samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
                    </devicePort>
                </devicePorts>
                <routes>
                    <route type="mix" sink="Remote Submix Out"
                           sources="r_submix output"/>
                    <route type="mix" sink="r_submix input"
                           sources="Remote Submix In"/>
                </routes>
        </module>
        <module name="bluetooth" halVersion="2.0">
            <mixPorts>
                <mixPort name="a2dp output" role="source"/>
                <mixPort name="hearing aid output" role="source">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="24000 16000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </mixPort>
            </mixPorts>
            <devicePorts>
                <devicePort tagName="BT A2DP Out" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP" role="sink">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100 48000 88200 96000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
                <devicePort tagName="BT A2DP Headphones" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES" role="sink">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100 48000 88200 96000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
                <devicePort tagName="BT A2DP Speaker" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_SPEAKER" role="sink">
                    <profile format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100 48000 88200 96000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
                <devicePort tagName="BT Hearing Aid Out" type="AUDIO_DEVICE_OUT_HEARING_AID" role="sink"/>
            </devicePorts>
            <routes>
                <route type="mix" sink="BT A2DP Out"
                       sources="a2dp output"/>
                <route type="mix" sink="BT A2DP Headphones"
                       sources="a2dp output"/>
                <route type="mix" sink="BT A2DP Speaker"
                       sources="a2dp output"/>
                <route type="mix" sink="BT Hearing Aid Out"
                       sources="hearing aid output"/>
            </routes>
        </module>
    </modules>
