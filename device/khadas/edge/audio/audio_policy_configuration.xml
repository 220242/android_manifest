<?xml version="1.0" encoding="utf-8"?>
<!--
  Khadas Edge1 (RK3399) - audio policy for an Android TV device.

  Differences from the Android 10 rk3399 tablet policy this replaces:
    * HDMI is the default and primary sink, not the speaker. The Edge1 has no
      speaker at all, so a "primary output" routed to AUDIO_DEVICE_OUT_SPEAKER
      leaves the device silent.
    * Multichannel (5.1/7.1) PCM and IEC61937 passthrough profiles are
      declared, which the legacy HAL does support but the tablet policy never
      exposed. AC3/E-AC3/DTS are NOT declared as formats: the HAL cannot open a
      stream in them (see the hdmi passthrough mixPort comment).
    * No builtin mic. Capture exists only over USB and the remote's mic
      (handled by the Bluetooth/USB modules, not the primary module).
-->
<audioPolicyConfiguration version="7.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <globalConfiguration speaker_drc_enabled="false" call_screen_mode_supported="false"/>

    <modules>
        <module name="primary" halVersion="AIDL">
            <attachedDevices>
                <item>HDMI Out</item>
                <item>SPDIF Out</item>
            </attachedDevices>
            <defaultOutputDevice>HDMI Out</defaultOutputDevice>

            <mixPorts>
                <!-- Stereo PCM: the default mix for UI and app audio. -->
                <mixPort name="primary output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </mixPort>

                <!-- Multichannel PCM for surround content decoded in the
                     framework. The ceiling is the HAL's: audio_hw.c accepts up
                     to 8 channels and special-cases 8ch@192kHz, defaulting an
                     unspecified mask to AUDIO_CHANNEL_OUT_5POINT1. -->
                <mixPort name="multichannel output" role="source"
                         flags="AUDIO_OUTPUT_FLAG_DIRECT">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100,48000,88200,96000,176400,192000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO,AUDIO_CHANNEL_OUT_5POINT1,AUDIO_CHANNEL_OUT_7POINT1"/>
                </mixPort>

                <!-- Compressed passthrough over HDMI.
                     IEC61937 only, deliberately.
                     Verified against hardware/rockchip/audio/tinyalsa_hal: the
                     legacy HAL declares exactly one format,
                     AUDIO_FORMAT_PCM_16_BIT, and implements passthrough as
                     SPDIF_PASSTHROUGH_MODE - it takes an already IEC61937-framed
                     PCM payload and fixes up the channel status bits
                     (setChanSta / fill_hdmi_bitstream_buf in audio_bitstream.c).
                     It does not parse or bitstream AC3/E-AC3/DTS as distinct
                     audio formats. Declaring AUDIO_FORMAT_AC3 or _DTS here
                     would make the framework offer direct passthrough that
                     open_output_stream then rejects, which apps surface as
                     silent playback rather than a clean fallback to PCM.
                     Adding true AC3/E-AC3/DTS passthrough is HAL work; see
                     docs/HAL_MIGRATION.md. -->
                <mixPort name="hdmi passthrough output" role="source"
                         flags="AUDIO_OUTPUT_FLAG_DIRECT AUDIO_OUTPUT_FLAG_COMPRESS_PASSTHROUGH">
                    <profile name="" format="AUDIO_FORMAT_IEC61937"
                             samplingRates="32000,44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </mixPort>

                <!-- S/PDIF is stereo PCM or IEC61937-framed data only; the
                     HAL validates the rate in adev_open_output_stream and
                     rejects anything outside 32/44.1/48kHz. -->
                <mixPort name="spdif output" role="source" flags="AUDIO_OUTPUT_FLAG_DIRECT">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                    <profile name="" format="AUDIO_FORMAT_IEC61937"
                             samplingRates="32000,44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </mixPort>
            </mixPorts>

            <devicePorts>
                <devicePort tagName="HDMI Out" type="AUDIO_DEVICE_OUT_HDMI" role="sink">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="32000,44100,48000,88200,96000,176400,192000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO,AUDIO_CHANNEL_OUT_5POINT1,AUDIO_CHANNEL_OUT_7POINT1"/>
                    <profile name="" format="AUDIO_FORMAT_IEC61937"
                             samplingRates="32000,44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
                <devicePort tagName="SPDIF Out" type="AUDIO_DEVICE_OUT_SPDIF" role="sink">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="32000,44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                    <profile name="" format="AUDIO_FORMAT_IEC61937"
                             samplingRates="32000,44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
                </devicePort>
            </devicePorts>

            <routes>
                <route type="mix" sink="HDMI Out"
                       sources="primary output,multichannel output,hdmi passthrough output"/>
                <route type="mix" sink="SPDIF Out" sources="spdif output"/>
            </routes>
        </module>

        <!-- Remote submix (Cast), USB audio and Bluetooth A2DP come from the
             AOSP module configs pulled in by device.mk. -->
        <xi:include href="r_submix_audio_policy_configuration.xml"/>
        <xi:include href="usb_audio_policy_configuration.xml"/>
        <xi:include href="bluetooth_audio_policy_configuration.xml"/>
    </modules>

    <xi:include href="audio_policy_volumes.xml"/>
    <xi:include href="default_volume_tables.xml"/>
</audioPolicyConfiguration>
