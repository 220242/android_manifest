-        av_image_copy_plane(data[0], linesize[0], mFrame->data[0], mFrame->linesize[0], w, h);
         if (data[2] == data[1] + 1) {
-            av_image_copy_plane(data[1], linesize[1], mFrame->data[1], mFrame->linesize[1],
-                                (w + 1) & ~1, (h + 1) / 2);
+            // One core copied a 4K frame in 13-20 ms on card 28 - with the decode
+            // beside it, the limit for 4K60. Above 1080p the bands are shared
+            // (persist.vendor.edge1.hwdec_copy_threads, default 2); 1080p takes
+            // 4 ms and stays on this thread.
+            CopyJob job;
+            addCopyBands(job, data[0], linesize[0], mFrame->data[0], mFrame->linesize[0], w, h);
+            addCopyBands(job, data[1], linesize[1], mFrame->data[1], mFrame->linesize[1],
+                         (w + 1) & ~1, (h + 1) / 2);
+            runCopyJob(job, (int64_t)w * h > 1920 * 1088 ? mCopyThreads : 1);
         } else {
+            av_image_copy_plane(data[0], linesize[0], mFrame->data[0], mFrame->linesize[0], w, h);
             // NV21: V first. Not what minigbm allocates, but cheap to get right.
             uint8_t* dst = data[2];
             for (int y = 0; y < (h + 1) / 2; y++) {
