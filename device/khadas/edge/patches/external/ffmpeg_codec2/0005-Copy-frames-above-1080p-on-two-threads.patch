+namespace {
+
+// A plane copied in bands of rows, which the copying threads take in turn: each
+// takes the next band when it is done with one, so a slower core (an A53 beside
+// an A72) just takes fewer.
+struct CopyBand {
+    uint8_t* dst;
+    int dstStride;
+    const uint8_t* src;
+    int srcStride;
+    int bytes;
+    int rows;
+};
+
+struct CopyJob {
+    std::vector<CopyBand> bands;
+    std::atomic<size_t> next{0};
+};
+
+constexpr int kCopyBandRows = 64;
+
+void addCopyBands(CopyJob& job, uint8_t* dst, int dstStride, const uint8_t* src,
+                  int srcStride, int bytes, int rows) {
+    for (int y = 0; y < rows; y += kCopyBandRows) {
+        job.bands.push_back({dst + (ptrdiff_t)y * dstStride, dstStride,
+                             src + (ptrdiff_t)y * srcStride, srcStride, bytes,
+                             std::min(kCopyBandRows, rows - y)});
+    }
+}
+
+void* copyBands(void* arg) {
+    CopyJob* job = static_cast<CopyJob*>(arg);
+    for (size_t i; (i = job->next.fetch_add(1)) < job->bands.size();) {
+        const CopyBand& b = job->bands[i];
+        av_image_copy_plane(b.dst, b.dstStride, b.src, b.srcStride, b.bytes, b.rows);
+    }
+    return nullptr;
+}
+
+// Runs the job on this thread and threads - 1 more. A helper that cannot be
+// started leaves its bands to the others.
+void runCopyJob(CopyJob& job, int threads) {
+    std::vector<pthread_t> helpers;
+    for (int i = 1; i < threads; i++) {
+        pthread_t t;
+        if (pthread_create(&t, nullptr, copyBands, &job) == 0) {
+            helpers.push_back(t);
+        }
+    }
+    copyBands(&job);
+    for (pthread_t t : helpers) {
+        pthread_join(t, nullptr);
+    }
+}
+
+}  // namespace
