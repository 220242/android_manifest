From ae1e0dbb34d3d115c84ca3ff7179073eb50f48ee Mon Sep 17 00:00:00 2001
From: Khadas Edge1 Android TV <edge1@localhost>
Date: Sat, 3 Oct 2026 23:03:04 +0000
Subject: [PATCH 10/10] android: H.264, MPEG-2, VP8 and VP9 over V4L2 request;
 no libdav1d

The Android build reads the pre-generated android/config.mak and
android/include, not configure, so the four hwaccels ported from
Kwiboo's v4l2-request-n7.0 are switched on there, beside the HEVC one
this tree has: rkvdec decodes H.264 and VP9 on the RK3399, hantro MPEG-2
and VP8.

libdav1d off: AOSP's external/libdav1d is a static library for its own
AV1 decoder (raspberry-vanilla replaces the whole project to get a
shared one), and the RK3399 has no AV1 hardware - c2.android.av1 stays
the AV1 decoder.

Two things the Android headers lack: v4l2_timeval_to_ns(), an inline
function of videodev2.h that bionic's copy of the uapi headers does not
carry, and fourcc_mod_is_vendor(), which came to drm_fourcc.h with
libdrm 2.4.111. v4l2_request.c defines both when they are missing.

Checked with clang for aarch64-linux-android34 against bionic's headers
(android-14.0.0_r75): every changed file compiles.
---
 android/config.mak                      |  8 ++++++--
 android/include/config.h                |  2 +-
 android/include/config_components.h     |  6 +++++-
 android/include/libavcodec/codec_list.c |  1 -
 libavcodec/v4l2_request.c               | 18 +++++++++++++++++-
 5 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/android/config.mak b/android/config.mak
index f1490f8..bd59d41 100644
--- a/android/config.mak
+++ b/android/config.mak
@@ -507,7 +507,7 @@ CONFIG_TRANSCODE_EXAMPLE=yes
 !CONFIG_LIBCACA=yes
 !CONFIG_LIBCELT=yes
 !CONFIG_LIBCODEC2=yes
-CONFIG_LIBDAV1D=yes
+!CONFIG_LIBDAV1D=yes
 !CONFIG_LIBDC1394=yes
 CONFIG_LIBDRM=yes
 !CONFIG_LIBFLITE=yes
@@ -1362,7 +1362,7 @@ CONFIG_XSUB_DECODER=yes
 !CONFIG_LIBARIBB24_DECODER=yes
 !CONFIG_LIBCELT_DECODER=yes
 !CONFIG_LIBCODEC2_DECODER=yes
-CONFIG_LIBDAV1D_DECODER=yes
+!CONFIG_LIBDAV1D_DECODER=yes
 !CONFIG_LIBDAVS2_DECODER=yes
 !CONFIG_LIBFDK_AAC_DECODER=yes
 !CONFIG_LIBGSM_DECODER=yes
@@ -1689,6 +1689,10 @@ CONFIG_ANULL_ENCODER=yes
 !CONFIG_HEVC_DXVA2_HWACCEL=yes
 !CONFIG_HEVC_NVDEC_HWACCEL=yes
 CONFIG_HEVC_V4L2REQUEST_HWACCEL=yes
+CONFIG_H264_V4L2REQUEST_HWACCEL=yes
+CONFIG_MPEG2_V4L2REQUEST_HWACCEL=yes
+CONFIG_VP8_V4L2REQUEST_HWACCEL=yes
+CONFIG_VP9_V4L2REQUEST_HWACCEL=yes
 !CONFIG_HEVC_VAAPI_HWACCEL=yes
 !CONFIG_HEVC_VDPAU_HWACCEL=yes
 !CONFIG_HEVC_VIDEOTOOLBOX_HWACCEL=yes
diff --git a/android/include/config.h b/android/include/config.h
index 17b638c..1eac04e 100644
--- a/android/include/config.h
+++ b/android/include/config.h
@@ -501,7 +501,7 @@
 #define CONFIG_LIBCACA 0
 #define CONFIG_LIBCELT 0
 #define CONFIG_LIBCODEC2 0
-#define CONFIG_LIBDAV1D 1
+#define CONFIG_LIBDAV1D 0
 #define CONFIG_LIBDC1394 0
 #define CONFIG_LIBDRM 1
 #define CONFIG_LIBFLITE 0
diff --git a/android/include/config_components.h b/android/include/config_components.h
index 1ccb43b..ba197de 100644
--- a/android/include/config_components.h
+++ b/android/include/config_components.h
@@ -577,7 +577,7 @@
 #define CONFIG_LIBARIBB24_DECODER 0
 #define CONFIG_LIBCELT_DECODER 0
 #define CONFIG_LIBCODEC2_DECODER 0
-#define CONFIG_LIBDAV1D_DECODER 1
+#define CONFIG_LIBDAV1D_DECODER 0
 #define CONFIG_LIBDAVS2_DECODER 0
 #define CONFIG_LIBFDK_AAC_DECODER 0
 #define CONFIG_LIBGSM_DECODER 0
@@ -904,6 +904,10 @@
 #define CONFIG_HEVC_DXVA2_HWACCEL 0
 #define CONFIG_HEVC_NVDEC_HWACCEL 0
 #define CONFIG_HEVC_V4L2REQUEST_HWACCEL 1
+#define CONFIG_H264_V4L2REQUEST_HWACCEL 1
+#define CONFIG_MPEG2_V4L2REQUEST_HWACCEL 1
+#define CONFIG_VP8_V4L2REQUEST_HWACCEL 1
+#define CONFIG_VP9_V4L2REQUEST_HWACCEL 1
 #define CONFIG_HEVC_VAAPI_HWACCEL 0
 #define CONFIG_HEVC_VDPAU_HWACCEL 0
 #define CONFIG_HEVC_VIDEOTOOLBOX_HWACCEL 0
diff --git a/android/include/libavcodec/codec_list.c b/android/include/libavcodec/codec_list.c
index 3cebcb7..6a0fd0b 100644
--- a/android/include/libavcodec/codec_list.c
+++ b/android/include/libavcodec/codec_list.c
@@ -668,7 +668,6 @@ static const FFCodec * const codec_list[] = {
     &ff_text_decoder,
     &ff_webvtt_decoder,
     &ff_xsub_decoder,
-    &ff_libdav1d_decoder,
     &ff_bintext_decoder,
     &ff_xbin_decoder,
     &ff_idf_decoder,
diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 813c1b3..9a614f7 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -37,10 +37,26 @@ static const AVClass v4l2_request_context_class = {
     .version    = LIBAVUTIL_VERSION_INT,
 };
 
+/* drm_fourcc.h from libdrm before 2.4.111 has no fourcc_mod_is_vendor(). */
+#ifndef fourcc_mod_get_vendor
+#define fourcc_mod_get_vendor(modifier) (((modifier) >> 56) & 0xff)
+#endif
+#ifndef fourcc_mod_is_vendor
+#define fourcc_mod_is_vendor(modifier, vendor) \
+    (fourcc_mod_get_vendor(modifier) == DRM_FORMAT_MOD_VENDOR_## vendor)
+#endif
+
+/* videodev2.h's v4l2_timeval_to_ns(): bionic's copy of the uapi headers has no
+ * inline functions. */
+static inline uint64_t v4l2_request_timeval_to_ns(const struct timeval *tv)
+{
+    return (uint64_t)tv->tv_sec * 1000000000ULL + tv->tv_usec * 1000;
+}
+
 uint64_t ff_v4l2_request_get_capture_timestamp(AVFrame *frame)
 {
     V4L2RequestDescriptor *req = (V4L2RequestDescriptor*)frame->data[0];
-    return req ? v4l2_timeval_to_ns(&req->capture.buffer.timestamp) : 0;
+    return req ? v4l2_request_timeval_to_ns(&req->capture.buffer.timestamp) : 0;
 }
 
 int ff_v4l2_request_reset_frame(AVCodecContext *avctx, AVFrame *frame)
