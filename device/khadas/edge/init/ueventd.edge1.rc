# Khadas Edge1 (RK3399) - device node permissions.

# Mali-T860
/dev/mali0                0666   system     graphics
# DRM/KMS - the composer3 service is the only vendor user
/dev/dri/card0            0660   system     graphics
/dev/dri/renderD128       0660   system     graphics
# Rockchip media accelerators
/dev/mpp_service          0660   media      media
/dev/rga                  0660   media      media
/dev/iep                  0660   media      media
/dev/vpu_service          0660   media      media
# HDMI-CEC
/dev/cec0                 0660   system     system
# IR receiver
/dev/lirc0                0660   system     system
# Bluetooth UART
/dev/ttyS0                0660   bluetooth  bluetooth
