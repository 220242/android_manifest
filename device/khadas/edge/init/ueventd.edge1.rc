# Khadas Edge1 (RK3399) - device node permissions.
#
# Mainline node names. The BSP's /dev/mali0, /dev/mpp_service, /dev/rga,
# /dev/iep and /dev/vpu_service do not exist on this kernel: the GPU is a DRM
# render node and the video accelerators are V4L2 devices.

# GPU. panfrost's render node, opened by Mesa in every process that draws - which
# is why it is 0666, the same reason /dev/mali0 was.
/dev/dri/renderD128       0666   system     graphics
# KMS (rockchip-drm) and panfrost's primary node. Not the composer's alone, as
# this file used to say: minigbm opens card0 in every process that touches a
# graphics buffer - the allocator, and the mapper inside each app - because
# rockchip-drm has no render node. At 0660 system:graphics no app could open it, so
# the mapper failed ("Failed to initialize driver", "Failed to importBuffer"),
# Mesa got no buffer and SystemUI's RenderThread died in
# panfrost_resource_set_damage_region on card 14, every few seconds. 0666, as
# AOSP's own ueventd.rc has /dev/dri/*; who may do what on them is SELinux's
# business (gpu_device, sepolicy/vendor/file_contexts), and only the composer is
# DRM master (kernel/patches/0001).
/dev/dri/card0            0666   system     graphics
/dev/dri/card1            0666   system     graphics

# Video: rkvdec and RGA as V4L2 M2M devices, plus the media controller.
/dev/video0               0660   media      media
/dev/video1               0660   media      media
/dev/media0               0660   media      media

# HDMI-CEC, from the Synopsys HDMI bridge's CEC block.
/dev/cec0                 0660   system     system
# IR receiver
/dev/lirc0                0660   system     system
# No /dev/rfkill entry, deliberately: it stays root-only. The Bluetooth HAL
# (android.hardware.bluetooth-service.default, user bluetooth) soft-blocks the
# Bluetooth rfkill switch before it binds to hci0, and the kernel will not open a
# blocked hci0 - so a HAL that can reach rfkill locks itself out. Denied, it logs
# "unable to open /dev/rfkill" and binds. See device.mk's Bluetooth section.
#
# No /dev/ttyS0 either: uart0 belongs to the kernel's hci_bcm (a serdev device),
# so there is no tty node for it.
