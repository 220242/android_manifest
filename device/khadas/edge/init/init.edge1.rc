# Khadas Edge1 (RK3399) - vendor init.
#
# Only board bring-up lives here. Every HAL service on this device is an AOSP one
# and ships its own .rc and VINTF fragment, which is the Android 14 convention -
# the Android 10 tree declared every HIDL service by hand in
# device/rockchip/common/init.rockchip.rc.

import /vendor/etc/init/hw/init.edge1.usb.rc

# The fstab is mounted from here, by the device - rootdir/init.rc only triggers the
# stages ("Mount fstab in init.{$device}.rc by mount_all command"). First-stage init
# mounts just the first_stage_mount entries (system, system_ext, product, vendor,
# odm); everything else - /metadata, and /data with latemount - is this. Without
# these two lines nothing mounted /data at all: the eighth card got as far as
# keystore2, which aborted on "unable to open database:
# /data/misc/keystore/persistent.sqlite", and apexd, finding no /data/apex,
# rebooted with "apexd-failed". On the first boot both partitions are blank and
# mount_all formats them, because the fstab marks them formattable.
on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late
    # The composer has to open /dev/dri/card0 before anything else does. The kernel
    # makes the first process to open a DRM primary node its master
    # (drm_master_open), and a later SET_MASTER needs CAP_SYS_ADMIN and no current
    # master (drm_setmaster_ioctl). minigbm opens card0 too - rockchip-drm has no
    # render node, renderD128 is panfrost - and the allocator service starts first in
    # "class_start hal", 40ms ahead of the composer. So on card 12 the allocator held
    # master, drm_hwcomposer logged "DRM/KMS master access required" and "No pipelines
    # available. Creating null-display for headless mode", and SurfaceFlinger drew a
    # 1024x768 nothing. Started here, at late-fs, the composer is first by 30 seconds;
    # minigbm's later opens need no master (dumb buffers and PRIME are not DRM_AUTH).
    start vendor.hwcomposer-2-4

# The menus at 1080p on a 4K TV: "ui=" in edge1-options.txt, which boot.scr passes as
# androidboot.edge1.ui (flash/boot.cmd has the why). SurfaceFlinger reads these two
# once, when it starts at "boot"; property triggers on ro.boot.* run right after
# late-init, well before that. Smaller TVs are untouched: the cap only shrinks a
# mode larger than itself, keeping its aspect ratio. Not set in a build.prop, where
# ui=native could not take it back.
on property:ro.boot.edge1.ui=1080
    setprop ro.surface_flinger.max_graphics_width 1920
    setprop ro.surface_flinger.max_graphics_height 1080

# Bring-up only: write logcat/dmesg snapshots to the card's EDGE1BOOT partition, and
# reboot warm if boot never completes, so the ramoops log survives for the card's
# boot script to save. bin/edge1-bootwatch.sh has the why.
service edge1_bootwatch /vendor/bin/edge1-bootwatch.sh
    class late_start
    user root
    group root
    oneshot
    disabled

on boot && property:ro.debuggable=1
    start edge1_bootwatch

# Edge1 Tools' root helper (bin/edge1-ctl.sh): CPU/GPU clock modes and the logs on
# the card. Started from init.edge1.ctl.rc on /product - a vendor file may not watch
# the sys.* / persist.sys.* properties the app (system user) sets - and init expands
# the property into the arguments, so the script reads no system property itself.
service edge1_ctl /vendor/bin/edge1-ctl.sh request ${sys.edge1.ctl:-none}
    user root
    group root
    oneshot
    disabled

service edge1_ctl_boot /vendor/bin/edge1-ctl.sh boot ${persist.sys.edge1.perf:-none}
    user root
    group root
    oneshot
    disabled

# The installer card: "install=emmc" or "install=nvme" in the card's
# edge1-options.txt, which boot.scr passes as androidboot.edge1.install (only when
# it runs from the card). Once the system is up, bin/edge1-install-boot.sh copies it
# onto that disk with bin/edge1-install-internal.sh. After the boot, not before:
# the copy reads the card's partitions, and the system it copies has to be the one
# that has just shown it can boot.
service edge1_install /vendor/bin/edge1-install-boot.sh ${ro.boot.edge1.install:-none}
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1 && property:ro.boot.edge1.install=emmc
    start edge1_install

on property:sys.boot_completed=1 && property:ro.boot.edge1.install=nvme
    start edge1_install

on early-init
    # Mali-T860 (Midgard) devfreq governor. simple_ondemand is what the
    # Rockchip 4.19 BSP validates the T860 OPP table against.
    write /sys/class/devfreq/ff9a0000.gpu/governor simple_ondemand

on init
    # big.LITTLE: 2x A72 (cpu4-5) + 4x A53 (cpu0-3).
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil

    # No DDR devfreq line. There were two, and neither could work on mainline:
    # /sys/class/devfreq/dmc did not exist (the node is "dmc: memory-controller"
    # in rk3399-base.dtsi with status = "disabled", and neither
    # rk3399-khadas-edge.dtsi nor rk3399-khadas-edge-v.dts enables it), and
    # "dmc_ondemand" is a Rockchip BSP governor that upstream does not have.
    # Leaving them in meant two init errors per boot and nothing tuned.
    chown system system /sys/class/devfreq/ff9a0000.gpu/governor

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/hostapd 0770 wifi wifi
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/media 0770 mediacodec media
    mkdir /data/vendor/tv 0770 system system

# No chown/chmod of device nodes here: ueventd.edge1.rc owns their modes (video,
# media, cec, lirc, dri). This file set some of them a second time, by fixed
# number, and once set /dev/dri/card0 back to 0660 after ueventd had made it
# 0666 - which is why card 15's launcher and SystemUI could not open it from
# their app uids while apps running as uid system drew fine.

# Compressed swap (fstab.edge1), after the boot rather than during it.
on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.${ro.hardware}

# ---------------------------------------------------------------------------
# Wi-Fi / Bluetooth: AP6398S (Broadcom BCM4359).
#
# Nothing to do here for either. Both drivers are built into the kernel and load
# their firmware from the ramdisk's /lib/firmware/brcm at boot: brcmfmac brings up
# wlan0, hci_bcm patches the BCM4359 over uart0 and registers hci0. The services
# are the modules' own: wpa_supplicant and hostapd start on demand through their
# AIDL interfaces, the Bluetooth HAL binds hci0 as a user channel. device.mk has
# the details, including why /dev/rfkill stays root-only.
#
# The BSP path needed a write to /sys/module/bcmdhd/parameters/firmware_path here
# and a "service brcm_patchram" for brcm_patchram_plus; neither driver nor tool
# exists on this kernel, and both are gone.
# ---------------------------------------------------------------------------

# A USB Wi-Fi adapter instead of the AP6398S. Android drives one Wi-Fi interface,
# the one named by wifi.interface (read each time Wi-Fi is switched on, HAL-less),
# and the AP6398S always comes up first as wlan0, so a USB adapter is wlan1 and
# idle. "setprop persist.vendor.edge1.wifi.iface wlan1" and a reboot hand Wi-Fi to
# it; clearing the property hands it back. Exact values rather than "=*", so an
# empty or mistyped value never leaves wifi.interface pointing at nothing.
on property:persist.vendor.edge1.wifi.iface=wlan1
    setprop wifi.interface wlan1
    setprop wifi.direct.interface p2p-dev-wlan1

on property:persist.vendor.edge1.wifi.iface=wlan2
    setprop wifi.interface wlan2
    setprop wifi.direct.interface p2p-dev-wlan2

# ---------------------------------------------------------------------------
# Android TV specifics.
# ---------------------------------------------------------------------------
# Nothing runs on boot_completed. There was a write to
# /sys/class/backlight/backlight/brightness, carried over from the tablet SKU
# this config started as. This board drives an HDMI display: there is no
# backlight device, the kernel fragment does not build BACKLIGHT_CLASS_DEVICE,
# and display power comes from HDMI-CEC standby instead.
