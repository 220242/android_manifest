# Khadas Edge1 (RK3399) - vendor init.
#
# Only board bring-up lives here. Every HAL service on this device is an AOSP one
# and ships its own .rc and VINTF fragment, which is the Android 14 convention -
# the Android 10 tree declared every HIDL service by hand in
# device/rockchip/common/init.rockchip.rc.

import /vendor/etc/init/hw/init.edge1.usb.rc

on early-init
    # Mali-T860 (Midgard) devfreq governor. simple_ondemand is what the
    # Rockchip 4.19 BSP validates the T860 OPP table against.
    write /sys/class/devfreq/ff9a0000.gpu/governor simple_ondemand

on init
    # big.LITTLE: 2x A72 (cpu4-5) + 4x A53 (cpu0-3).
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil

    # DDR devfreq. The legacy tree drove this from a userspace daemon; on 14
    # the dmc governor handles it.
    write /sys/class/devfreq/dmc/governor dmc_ondemand

    chown system system /sys/class/devfreq/dmc/governor
    chown system system /sys/class/devfreq/ff9a0000.gpu/governor

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/hostapd 0770 wifi wifi
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/media 0770 mediacodec media
    mkdir /data/vendor/tv 0770 system system

on boot
    # HDMI-CEC device node for the AIDL hdmi.cec service.
    chown system system /dev/cec0
    chmod 0660 /dev/cec0

    # The GPU is reached through the DRM render node, not /dev/mali0: that node
    # belonged to the BSP's midgard kmod and does not exist with panfrost. Mesa
    # opens the render node from every process that draws, so it has to be
    # world-accessible - the same reason /dev/mali0 was 0666 on the old path.
    chown system graphics /dev/dri/renderD128
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/card0
    chmod 0660 /dev/dri/card0

    # Video: mainline exposes rkvdec and RGA as V4L2 M2M devices, replacing
    # /dev/mpp_service and /dev/rga. Which index each lands on depends on probe
    # order, so the whole range is set rather than one node.
    chown media media /dev/video0
    chmod 0660 /dev/video0
    chown media media /dev/video1
    chmod 0660 /dev/video1
    chown media media /dev/media0
    chmod 0660 /dev/media0

    # IR receiver on the Edge1 front edge.
    chown system system /dev/lirc0

# ---------------------------------------------------------------------------
# Wi-Fi / Bluetooth: AP6398S (Broadcom BCM4359).
#
# Nothing to do for Wi-Fi. brcmfmac is built into the kernel and asks the kernel
# firmware loader for brcm/brcmfmac4359-sdio.{bin,txt}, which device.mk installs
# into /vendor/firmware. The BSP path needed a write to
# /sys/module/bcmdhd/parameters/firmware_path here; brcmfmac has no such
# parameter, and pointing at a module that is not loaded was the kind of line
# that looks like configuration and does nothing.
#
# Bluetooth is not started. It needs the BCM4359's firmware patch loaded over
# uart0 before an HCI device exists, and the two ways to do that pull in opposite
# directions: the kernel's hci_bcm driver does it itself but then owns the port,
# while Android's Bluetooth HAL wants to open the tty and patch it from
# userspace with brcm_patchram_plus - a vendor tool this tree no longer carries.
# The kernel driver is left out of the config so the port stays free for whichever
# is chosen. docs/STATUS.md tracks it.
# ---------------------------------------------------------------------------
    oneshot

on property:bluetooth.hci.enabled=1
    start brcm_patchram

# ---------------------------------------------------------------------------
# Android TV specifics.
# ---------------------------------------------------------------------------
on property:sys.boot_completed=1
    # A TV box has no battery and no ambient light sensor; keep the display on
    # and let HDMI-CEC standby drive power state instead.
    write /sys/class/backlight/backlight/brightness 255
