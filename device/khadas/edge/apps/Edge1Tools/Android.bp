// Edge1 Tools: the performance overlay, the installer of the apps on the image,
// one by one on request (build/fetch-apps.sh), and Settings' Sound & display screen
// (SoundActivity). Platform-signed so that the system grants it, by signature, what
// the first two need: drawing over other apps, the per-task frame rate
// (ACCESS_FPS_COUNTER), installing packages without a prompt, and choosing the
// default launcher. Nothing here needs it to be privileged. TvSettings lists the
// Sound screen only for a system app, which an app on /system_ext is.
android_app {
    name: "Edge1Tools",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
}
