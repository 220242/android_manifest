<?xml version="1.0" encoding="utf-8"?>
<!-- A setting that is on or off: the whole row is the control, the switch shows it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Edge1.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tile_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/title"
            style="@style/Text.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/text_tile_title" />
        <TextView
            android:id="@+id/summary"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:textColor="@color/text_tile_body" />
    </LinearLayout>

    <Switch
        android:id="@+id/toggle"
        style="@style/Edge1.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp" />
</LinearLayout>
