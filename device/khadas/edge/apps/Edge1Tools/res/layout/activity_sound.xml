<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Sound & display: the level, a test sound, where it goes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin_h"
        android:paddingEnd="@dimen/screen_margin_h"
        android:paddingTop="@dimen/screen_margin_v"
        android:paddingBottom="@dimen/screen_margin_v">

        <TextView
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_title" />

        <LinearLayout style="@style/Edge1.Card">
            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sound_volume" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/level"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum" />
                <TextView
                    android:id="@+id/level_of"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/m3_on_surface_variant" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:focusable="false"
                android:progressDrawable="@drawable/progress_level" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/quieter"
                    style="@style/Edge1.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_minus"
                    android:text="@string/sound_quieter" />
                <Button
                    android:id="@+id/louder"
                    style="@style/Edge1.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawableStart="@drawable/ic_plus"
                    android:text="@string/sound_louder" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <Button
                    android:id="@+id/test"
                    style="@style/Edge1.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/sound_test" />
            </LinearLayout>
            <TextView
                android:id="@+id/output"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawablePadding="12dp"
                android:drawableStart="@drawable/ic_tv"
                android:gravity="center_vertical" />
            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sound_note" />
        </LinearLayout>

        <LinearLayout style="@style/Edge1.Card">
            <include android:id="@+id/row_display" layout="@layout/row_nav" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
