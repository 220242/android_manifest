<?xml version="1.0" encoding="utf-8"?>
<!-- M3 linear indicator: a rounded track, the level in primary with rounded ends. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_highest" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/m3_primary" />
                <corners android:radius="6dp" />
            </shape>
        </scale>
    </item>
</layer-list>
