<?xml version="1.0" encoding="utf-8"?>
<!-- M3 switch track, 52x32: primary when on; outlined surface when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_primary" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_highest" />
            <stroke android:width="2dp" android:color="@color/m3_outline" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
</selector>
