 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
 
@@ -49,11 +51,33 @@
 #define TRNG_RNG_SAMPLE_CNT		0x0404
 #define TRNG_RNG_DOUT			0x0410
 
+/*
+ * RK3399: the TRNG of the crypto block (the RK3288 one, "crypto v1"), from
+ * Rockchip's own driver (rockchip,cryptov1-rng). CTRL takes a write mask in its
+ * upper 16 bits; TRNG_CTRL does not. The osc ring is sampled every
+ * RK3399_RNG_SAMPLE_PERIOD cycles of the crypto clock, as Rockchip's driver does.
+ */
+#define CRYPTO_V1_CTRL			0x0008
+#define CRYPTO_V1_RNG_START		BIT(8)
+#define CRYPTO_V1_TRNG_CTRL		0x0200
+#define CRYPTO_V1_OSC_ENABLE		BIT(16)
+#define CRYPTO_V1_TRNG_DOUT_0		0x0204
+#define RK3399_RNG_SAMPLE_PERIOD	100
+#define RK3399_RNG_POLL_TIMEOUT_US	50000
+
+struct rk_rng_soc_data {
+	int (*init)(struct hwrng *rng);
+	void (*cleanup)(struct hwrng *rng);
+	int (*read)(struct hwrng *rng, void *buf, size_t max, bool wait);
+	u16 quality;
+};
+
 struct rk_rng {
 	struct hwrng rng;
 	void __iomem *base;
 	int clk_num;
 	struct clk_bulk_data *clk_bulks;
+	const struct rk_rng_soc_data *soc_data;
 };
 
 /* The mask in the upper 16 bits determines the bits that are updated */
@@ -128,6 +152,87 @@ static int rk_rng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
 	return (ret < 0) ? ret : to_read;
 }
 
+static int rk3399_rng_init(struct hwrng *rng)
+{
+	struct rk_rng *rk_rng = container_of(rng, struct rk_rng, rng);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(rk_rng->clk_num, rk_rng->clk_bulks);
+	if (ret < 0) {
+		dev_err((struct device *) rk_rng->rng.priv,
+			"Failed to enable clks %d\n", ret);
+		return ret;
+	}
+
+	/* enable the osc ring and set the sample period */
+	writel(CRYPTO_V1_OSC_ENABLE | RK3399_RNG_SAMPLE_PERIOD,
+	       rk_rng->base + CRYPTO_V1_TRNG_CTRL);
+
+	return 0;
+}
+
+static void rk3399_rng_cleanup(struct hwrng *rng)
+{
+	struct rk_rng *rk_rng = container_of(rng, struct rk_rng, rng);
+
+	/* stop the osc ring */
+	writel(0, rk_rng->base + CRYPTO_V1_TRNG_CTRL);
+
+	clk_bulk_disable_unprepare(rk_rng->clk_num, rk_rng->clk_bulks);
+}
+
+static int rk3399_rng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
+{
+	struct rk_rng *rk_rng = container_of(rng, struct rk_rng, rng);
+	size_t to_read = min_t(size_t, max, RK_RNG_MAX_BYTE);
+	u32 reg;
+	int ret = 0;
+
+	ret = pm_runtime_resume_and_get((struct device *) rk_rng->rng.priv);
+	if (ret < 0)
+		return ret;
+
+	/* Start collecting random data; the bit clears when 256 bits are in */
+	writel((CRYPTO_V1_RNG_START << 16) | CRYPTO_V1_RNG_START,
+	       rk_rng->base + CRYPTO_V1_CTRL);
+
+	ret = readl_poll_timeout(rk_rng->base + CRYPTO_V1_CTRL, reg,
+				 !(reg & CRYPTO_V1_RNG_START),
+				 RK_RNG_POLL_PERIOD_US,
+				 RK3399_RNG_POLL_TIMEOUT_US);
+	if (ret < 0)
+		goto out;
+
+	/* Read random data stored in the registers */
+	memcpy_fromio(buf, rk_rng->base + CRYPTO_V1_TRNG_DOUT_0, to_read);
+out:
+	/* stop collecting, also after a timeout */
+	writel(CRYPTO_V1_RNG_START << 16, rk_rng->base + CRYPTO_V1_CTRL);
+
+	pm_runtime_mark_last_busy((struct device *) rk_rng->rng.priv);
+	pm_runtime_put_sync_autosuspend((struct device *) rk_rng->rng.priv);
+
+	return (ret < 0) ? ret : to_read;
+}
+
+static const struct rk_rng_soc_data rk3568_soc_data = {
+	.init = rk_rng_init,
+	.cleanup = rk_rng_cleanup,
+	.read = rk_rng_read,
+	.quality = 900,
+};
+
+/*
+ * Not measured on RK3399: Rockchip's driver claims 999. Half of that is credited
+ * until someone measures it; /sys/class/misc/hw_random/rng_quality changes it.
+ */
+static const struct rk_rng_soc_data rk3399_soc_data = {
+	.init = rk3399_rng_init,
+	.cleanup = rk3399_rng_cleanup,
+	.read = rk3399_rng_read,
+	.quality = 500,
+};
+
 static int rk_rng_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
