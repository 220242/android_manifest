#
# Khadas Edge1 (RK3399) - Android 14 config delta over arm64 defconfig, Linux 6.12 LTS.
#
# Base: arch/arm64/configs/defconfig, which already carries the RK3399 SoC support
# (ARCH_ROCKCHIP, the PMIC, eMMC/SDIO, PCIe, USB PHYs, stmmac, thermal). What it
# does not carry is Android's own requirements, and it builds the three drivers
# this port depends on - DRM, panfrost, brcmfmac - as modules.
#
# Everything here is built in rather than modular. There is no vendor_dlkm in this
# layout and no module loading in first-stage init, so a module is a driver that
# does not exist.
#
# Every symbol below was checked against the Kconfig files of v6.12.111. Build
# with build/build-kernel.sh, which merges this onto defconfig and then reports
# any symbol that did not take.

# ---------------------------------------------------------------------------
# Android core.
#
# Grouped by the release that introduced the requirement, because that is what
# decides whether it is negotiable: a binderfs miss is a boot hang, while PSI
# only degrades lmkd.
# ---------------------------------------------------------------------------
# Android 8+: binder, mounted as binderfs (11+). The device list is NOT empty: each
# binderfs mount creates the devices named here (drivers/android/binderfs.c,
# binderfs_fill_super walks binder_devices_param), and init.rc only symlinks
# /dev/binder, /dev/hwbinder and /dev/vndbinder into the mount - it never creates
# them. An empty list left all three dangling: servicemanager, hwservicemanager and
# vndservicemanager could not open their device, and nothing after them can start.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Android 11+: lmkd reads pressure stall information rather than polling.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# Android 11+: memory and scheduler cgroups. MEMCG_V1 because libprocessgroup
# still writes the v1 hierarchy paths on a device that does not opt into v2-only.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
# Android's cpuset hierarchy is cgroup v1, and mounted the old way - as a filesystem
# of type "cpuset" (libprocessgroup/setup/cgroup_map_write.cpp, "mount cpuset none
# /dev/cpuset"). 6.12 moved that into its own symbol, default n; without it the
# mount fails, the eighth card logged a module request for "fs-cpuset", and every
# task profile that moves a process between foreground and background has nowhere
# to write.
CONFIG_CPUSETS_V1=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_AUTOGROUP=y

# Android 13+: netd's traffic accounting and firewall are eBPF programs. Without
# these, networking comes up and then nothing can reach it.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_BPF_STREAM_PARSER=y

# Android 14: userfaultfd. PRODUCT_ENABLE_UFFD_GC is false for this board, so ART
# does not use it, but adb and CoW paths do.
CONFIG_USERFAULTFD=y

# Verified boot and encryption. fscrypt v2 for userdata, dm-verity for the
# read-only partitions, and dm for dynamic partitions (super) - libsnapshot maps
# every logical partition with dm-linear, which is part of dm-mod.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_FS_ENCRYPTION=y
# Dropped: FS_ENCRYPTION_INLINE_CRYPT. It was asked for here and never took - it
# depends on BLK_INLINE_ENCRYPTION, which defconfig leaves off. Adding that
# would buy nothing - it routes fscrypt through inline crypto *hardware*, the
# RK3399 has none, and fstab.edge1 does not use the inlinecrypt mount option. So
# the dependency stays off and the symbol goes, rather than having the build
# report a symbol that did not take on every run.
CONFIG_FS_VERITY=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_FUSE_FS=y

# SELinux in enforcing mode is not optional on Android.
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_NETWORK=y
# Built is not enabled: SELinux also has to be in the LSM list, the LSMs that are
# initialised. build-kernel.sh runs "make defconfig" first, and arm64 defconfig has no
# major LSM, so that list is computed then as the DAC default -
# "landlock,lockdown,yama,loadpin,safesetid,ipe,bpf" (security/Kconfig) - and a string
# that already has a value survives the merge and olddefconfig untouched. The first
# kernel to boot on the board printed "LSM: initializing lsm=capability", SELinux never
# initialised, and first-stage init stopped at its third mount: mount("selinuxfs",
# "/sys/fs/selinux") failed Invalid argument, "Init encountered errors starting first
# stage, aborting". Stated here, the merge sets it and build-kernel.sh verifies it.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"
# What lets androidboot.selinux=permissive work at all: without it the kernel refuses
# a write of 0 to /sys/fs/selinux/enforce, and init treats that as fatal. Default y,
# stated for the same reason as the LSM list.
CONFIG_SECURITY_SELINUX_DEVELOP=y

# Graphics buffer plumbing. Android allocates through dma-buf heaps; ION is gone
# and minigbm uses the DRM node plus the system heap.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y

# The kernel config has to be readable back out of the image: the platform build
# extracts it with extract_kernel.py for the OTA metadata, and VTS scores the
# kernel config test from /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---------------------------------------------------------------------------
# Display. Rockchip DRM/KMS plus the Synopsys HDMI bridge.
#
# This is what AOSP's drm_hwcomposer and minigbm talk to. No Rockchip vendor
# display code is involved on this path.
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y

# The kernel log on HDMI. BoardConfig.mk puts console=tty0 on a userdebug command line
# because this board is brought up without a UART adapter, and fbcon over the DRM
# device is what makes tty0 visible. In 6.12 FRAMEBUFFER_CONSOLE is
# "default DRM_FBDEV_EMULATION" (drivers/video/console/Kconfig:74-77) and VT is
# "default y if !UML", so both should arrive by themselves - but a default only
# applies to a symbol nothing has decided yet, which is exactly how U-Boot's
# CONSOLE_MUX stayed off (build-uboot.sh). Stated here, build-kernel.sh verifies
# they took.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# The board LED, which is the kernel's only signal before HDMI comes up. sys_led has
# linux,default-trigger = "heartbeat" in rk3399-khadas-edge.dtsi, and build-kernel.sh
# marks it panic-indicator in the dtb it stages, so the LED tells three states apart:
#   heartbeat - two short blinks, a pause    the kernel is running
#   an even blink, 2.5 times a second        the kernel panicked (kernel/panic.c
#                                            toggles panic-indicator LEDs every 200ms)
#   neither                                  no kernel, or it hung before the LED
#                                            driver probed
# Armbian's kernel runs the same heartbeat, so only the second and third say anything
# about this build. All three are =y in arm64 defconfig; stated so they are verified.
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_PANIC=y

# The kernel log, and Android's, kept in RAM across a reset. build-kernel.sh adds a
# ramoops region to the dtb; the console zone holds everything printk says (init's
# own messages included), pmsg what liblog writes on a debuggable build, and the dmesg
# zones the log at the moment of a panic. After the reset the boot script copies the
# region to edge1-pstore.bin on bootfs before it starts the next kernel, and
# build/edge1-pstore.py turns that back into text. This is the board's only kernel
# log until a UART adapter is attached. Uncompressed, so a damaged byte costs a
# character rather than the record. arm64 defconfig has PSTORE_RAM only as a module,
# which first-stage init would never load.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_COMPRESS is not set

# tracefs, for Android's trace marker and perfetto. arm64 defconfig leaves ftrace
# off, so /sys/kernel/tracing did not exist and every process that links libcutils
# logged "cutils-trace: Error opening trace file: No such file or directory" at
# start (tenth card). FTRACE alone brings TRACING, EVENT_TRACING and the nop
# tracer - the trace_marker file and the scheduler/binder events atrace reads -
# and BPF_EVENTS for bpf tracepoint programs; no function tracer, so no mcount
# patching cost.
CONFIG_FTRACE=y

# ---------------------------------------------------------------------------
# GPU: panfrost, the mainline Mali driver.
#
# The whole reason this port moved off the 4.19 BSP. AOSP 14 ships
# external/mesa3d with a panfrost gallium driver (libmesa_pipe_panfrost), so the
# Mali-T860 gets GLES with no proprietary blob - but only against this driver,
# never against the BSP's midgard kmod.
# ---------------------------------------------------------------------------
CONFIG_DRM_PANFROST=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# Dropped: ARM_RK3399_DMC_DEVFREQ. It drives the DDR controller's frequency, and
# on this board the device does not exist - the node is
# "dmc: memory-controller" in rk3399-base.dtsi with status = "disabled", and
# neither rk3399-khadas-edge.dtsi nor rk3399-khadas-edge-v.dts enables it. The
# init.rc write to /sys/class/devfreq/dmc and the genfs label for it went with it.

# ---------------------------------------------------------------------------
# HDMI audio. simple-audio-card wires i2s2 to the HDMI bridge's codec, which is
# how rk3399-base.dtsi declares hdmi_sound; the Edge dtsi enables it.
# ---------------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y

# ---------------------------------------------------------------------------
# Video decode: two V4L2 stateless (request API) decoders.
#
#   rkvdec  (staging) H.264 and VP9 - rkvdec-h264.c, rkvdec-vp9.c in 6.12
#   hantro  (the RK3399 "VPU") MPEG-2 and VP8; defconfig has it =m, hence =y
#
# HEVC on rkvdec is not in 6.12. Stateless decoders need userspace to parse the
# bitstream and fill the request controls; AOSP's external/v4l2_codec2 only drives
# stateful ones, so the Android side is FFmpeg's v4l2-request hwaccel under a
# Codec2 service - docs/HW_DECODE.md. Until then everything is software.
# ---------------------------------------------------------------------------
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_ROCKCHIP_VDEC=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_RGA=y

# ---------------------------------------------------------------------------
# Wi-Fi: AP6398S is a BCM4359. On mainline that is brcmfmac over SDIO, not the
# BSP's bcmdhd, and the DTS already declares the wifi@1 node with its power
# sequence. Firmware and the board NVRAM ship in /vendor/firmware/brcm and, because
# the built-in driver probes at 1.4s - long before /vendor is mounted (card 16:
# "Direct firmware load ... failed with error -2", no wlan0) - in the ramdisk's
# /lib/firmware/brcm too, which the firmware loader searches after waiting for
# the initramfs.
# ---------------------------------------------------------------------------
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_NL80211_TESTMODE=y

# Bluetooth: the BCM4359's HCI is on uart0, which the DTS describes as a serdev
# child (brcm,bcm43438-bt, with its shutdown/wake GPIOs and the RK808 LPO clock).
# hci_bcm owns that port: it powers the chip, loads brcm/BCM4359C0.hcd and
# registers hci0. Android's AIDL HAL (android.hardware.bluetooth-service.default)
# then takes hci0 over an HCI user channel (net_bluetooth_mgmt.cpp) - so the kernel
# does the Broadcom-specific part and no vendor tool is needed. Card 14 showed the
# other way round failing: without hci0 the HAL waited forever and the stack
# aborted. defconfig has BT_HCIUART=m, and modules are not shipped, hence =y -
# which also takes POWER_SEQUENCING=y: BT_HCIUART "depends on POWER_SEQUENCING ||
# !POWER_SEQUENCING", and defconfig's Qualcomm PCI power control pulls that in as
# m, which would hold BT_HCIUART at m.
# The .hcd is in the ramdisk as well as /vendor: hci0 is set up at 1-2s, before
# /vendor is mounted.
CONFIG_BT=y
CONFIG_POWER_SEQUENCING=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y

# ---------------------------------------------------------------------------
# The fan. The Edge-V's DTS has a pwm-fan on pwm0, driven by the gpu thermal zone
# (55C warm, 65C hot). defconfig builds pwm-fan as a module and modules are not
# shipped, so up to card 18 the fan never turned. That was not card 18's reboot
# loop (its overlay showed 40-45C, far from the tsadc's 95C hardware shutdown),
# but a long full load in a closed case would get there.
# ---------------------------------------------------------------------------
CONFIG_SENSORS_PWM_FAN=y

# ---------------------------------------------------------------------------
# USB drives. vfat comes with defconfig. exFAT is how large sticks and cards come
# formatted, and vold mounts it when the kernel has it and /system/bin has
# fsck.exfat and mkfs.exfat (device.mk). UAS is the USB 3 disk protocol most SSD
# enclosures speak; without it they drop to the slower bulk-only transport. vold
# mounts with iocharset utf8, which needs the UTF-8 NLS table.
# No NTFS: the kernel has a driver, but vold in Android 14 mounts no NTFS volume,
# so it would change nothing that an app can see.
# ---------------------------------------------------------------------------
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_USB_UAS=y

# ---------------------------------------------------------------------------
# zram: compressed swap in RAM, sized in fstab.edge1 and switched on by
# init.edge1.rc. 4GB fills up with a launcher, a browser and a video app kept
# warm; compressed swap lets lmkd keep them instead of killing them. LZ4: the
# fastest of the compressors on the A53s.
# ---------------------------------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# ---------------------------------------------------------------------------
# USB Wi-Fi and Bluetooth adapters: the popular chipsets with drivers in 6.12,
# built in (modules are not shipped). Their firmware is in firmware/usb/ and, like
# the AP6398S's, in the ramdisk too - an adapter plugged in at power-on is probed
# at about two seconds. firmware/usb/README.md maps chipsets to adapters. Not in
# 6.12: RTL8812AU/8821AU (6.14) and the rtw89 USB Wi-Fi 6 chips (6.17).
# ---------------------------------------------------------------------------
# Realtek 802.11ac: RTL8811CU/8821CU, 8812BU/8822BU, 8822CU, 8723DU.
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8723DU=y
# Realtek 802.11n: RTL8188CU/EU/FU/GU, 8192CU/EU/FU, 8723BU. _UNTESTED adds the
# chips rtl8xxxu supports but does not claim by default (8188EU, 8192EU ...).
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
# MediaTek: MT7601U, MT7610U, MT7612U, MT7921AU (Wi-Fi 6).
CONFIG_MT7601U=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y
CONFIG_MT7921U=y
# Atheros AR9271/AR7010.
CONFIG_ATH9K_HTC=y
# Ralink RT2870/RT3070/RT3572/RT5370/RT5372.
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
# Bluetooth over USB: CSR and Broadcom sticks, Realtek RTL8761B/BU and combo
# chips, MediaTek MT7921. defconfig has HCIBTUSB=m.
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y

# ---------------------------------------------------------------------------
# Storage, USB and networking that the board needs built in rather than modular.
# ---------------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
# Three symbols, in this order, or there is no Ethernet. DWMAC_ROCKCHIP sits
# inside "if STMMAC_PLATFORM" in drivers/net/ethernet/stmicro/stmmac/Kconfig, and
# STMMAC_PLATFORM is a tristate: while it is m, a driver under it cannot be y, so
# olddefconfig quietly demoted DWMAC_ROCKCHIP back to m - and a module is a driver
# that does not exist in this layout. Setting STMMAC_ETH alone was not enough;
# that is what build-kernel.sh reported as a symbol that did not take.
#
# The symbol names above are written without the CONFIG_ prefix on purpose.
# merge_config.sh collects the symbols to merge with two sed patterns and then
# does "grep -w $CFG" over the whole fragment for the value, so a comment that
# also mentions a symbol the fragment sets makes that grep return two lines and
# the override warning prints nonsense. verify-tree.sh check 7 enforces it.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
# No PCIe, for now. Up to card 19 the controller was built in and its PHY a module,
# so it never probed: it sat in "deferred probe pending" and was probed again each
# time another device bound. Card 20 built the PHY in and came back with no
# edge1-logs at all - Android apparently never reached its log recorder - and RAM
# cleared as by a power cut. Of that build's changes this is the one that runs
# early in the kernel and can hang it: mainline's PCIe
# PHY on this SoC is the part Armbian patches (rk3399-fix-pci-phy.patch, "pll relock
# timeout!" in docs/HARDWARE.md), and the M.2 slot is empty - so the controller is
# out until there is an SSD to test it with.
# CONFIG_PCIE_ROCKCHIP_HOST is not set
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_CPUFREQ_DT=y

# Hardening that Android expects and that costs nothing to turn on here.
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
# Dropped: INIT_STACK_ALL_ZERO. It depends on CC_HAS_AUTO_VAR_INIT_ZERO, which is
# a compiler probe for
# -ftrivial-auto-var-init=zero: GCC gained that in 12, and the cross compiler in
# this build environment is the distro's GCC 11, so the symbol can never be set
# here. It came back as "NOT SET" on every run, which is how a verification loop
# stops being read. Getting it needs KERNEL_USE_CLANG=1 (AOSP's clang has it) or
# a newer cross GCC; both are toolchain changes, not config changes, and neither
# is worth making while the first boot is still the open question.

# ---------------------------------------------------------------------------
# Android's base kernel requirements.
#
# The list Android's own kernel/configs keeps as android-base.config for its 6.1 LTS
# - the one VTS checks - as GloDroid carries it for Android 14 on mainline kernels
# (platform/kernel/android-base.config in glodroid_device). Without it, arm64
# defconfig leaves IPv6, iptables and conntrack as modules and most xt matches out,
# and netd builds its firewall and bandwidth chains out of exactly those: a module is
# a driver that does not exist here, and a netd that cannot start keeps
# system_server from finishing boot.
#
# Taken as-is, minus what was already stated above and these, each checked against
# the v6.12 Kconfig with the kernel's own merge (defconfig, merge_config.sh -m,
# olddefconfig, scripts/dummy-tools):
#   not in upstream 6.12      ANDROID ASHMEM UID_SYS_STATS DM_DEFAULT_KEY
#                             NETFILTER_XT_MATCH_QUOTA2(_LOG) USB_CONFIGFS_UEVENT
#                             USB_CONFIGFS_F_ACC USB_CONFIGFS_F_AUDIO_SRC - Android
#                             common kernel only; userspace copes without them
#   facts about the toolchain CC_IS_CLANG LD_IS_LLD AS_IS_LLVM - this is a GCC build
#   cannot take here          HID_PLAYSTATION (held at m by a dependency), the unset
#                             FHANDLE and FW_CACHE (only promptable with EXPERT)
#   left out on purpose       MODVERSIONS (no modules are loaded), DEBUG_LIST,
#                             EMBEDDED, STATIC_USERMODEHELPER (VTS-only, and it
#                             redirects every usermode helper)
# Every line below is verified to take by build-kernel.sh, like the rest.
# ---------------------------------------------------------------------------
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_BPFILTER is not set
# CONFIG_DEVMEM is not set
# CONFIG_IP6_NF_NAT is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_NFSD is not set
# CONFIG_NFS_FS is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_RT_GROUP_SCHED is not set
# CONFIG_SYSVIPC is not set
# CONFIG_USELIB is not set
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_AUDIT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLOCK=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_XCBC=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DUMMY=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_FUTEX=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_ESP=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INOTIFY_USER=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IPV6=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_VTI=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_MULTIPLE_TABLES=y
