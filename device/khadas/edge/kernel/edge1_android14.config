# Khadas Edge1 (RK3399) - Android 14 kernel config delta.
#
# Applied on top of arch/arm64/configs/kedge_defconfig (kernel 4.19.111,
# khadas-edge-Qt) by build/build-kernel.sh via scripts/kconfig/merge_config.sh.
#
# Every entry below is either (a) mandated by the Android 14 VTS kernel config
# tests, or (b) required by an Android 11..14 userspace change that the Android
# 10 defconfig predates. Grouped by the reason it is needed, because a bare
# config list is unreviewable.

# ---------------------------------------------------------------------------
# binderfs - required since Android 11.
#
# Android 11 moved binder device creation from static CONFIG_ANDROID_BINDER_DEVICES
# to binderfs mounted at /dev/binderfs. With the Android 10 setting, init cannot
# create the vndbinder/hwbinder nodes and every AIDL HAL fails to register.
# ---------------------------------------------------------------------------
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""

# ---------------------------------------------------------------------------
# eBPF networking - required since Android 13.
#
# netd's traffic accounting, per-UID firewall and data saver are all eBPF
# programs from Android 13 onward. Without these, netd aborts on boot and the
# device never gets a working network stack.
# ---------------------------------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_BTF is deliberately absent. It needs a pahole new enough to
# emit BTF for a 4.19 tree, which Ubuntu 22.04 does not have, and the merge
# reported it as not set. Android's own eBPF programs are compiled against the
# kernel's headers and do not need CO-RE, so nothing here requires BTF.

# ---------------------------------------------------------------------------
# lmkd via PSI - required since Android 11.
#
# The in-kernel lowmemorykiller driver was removed from the platform; lmkd now
# reads pressure stall information. Leaving the old driver enabled makes the
# kernel kill processes behind lmkd's back.
# ---------------------------------------------------------------------------
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set

# ---------------------------------------------------------------------------
# userfaultfd - required by the Android 14 ART GC.
#
# Android 14's default ART collector is the userfaultfd-based concurrent
# compacting GC. Without CONFIG_USERFAULTFD, ART falls back at runtime but
# zygote logs a warning on every fork and app start latency regresses badly.
# ---------------------------------------------------------------------------
CONFIG_USERFAULTFD=y
CONFIG_MEMFD_CREATE=y

# ---------------------------------------------------------------------------
# Storage: dynamic partitions, verity, FBE.
# ---------------------------------------------------------------------------
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_VERITY_AVB=y
CONFIG_DM_BOW=y
CONFIG_DM_SNAPSHOT=y
CONFIG_BLK_DEV_DM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTA_TREE=y
CONFIG_QUOTACTL=y
CONFIG_OVERLAY_FS=y

# sdcardfs must go. It was removed from the platform in Android 11 in favour of
# a FUSE-based /storage. The legacy product set ro.sys.sdcardfs=true; that
# property is not set by this tree and the driver is disabled so it cannot be
# mounted accidentally.
# CONFIG_SDCARD_FS is not set

# fscrypt v2 note: v2 policies need mainline >= 5.4 or the ACK
# android-4.19-stable backports, which this kernel does not carry. The fstab
# therefore pins policy v1, which is legal because
# PRODUCT_SHIPPING_API_LEVEL is 29. See docs/KERNEL.md.

# ---------------------------------------------------------------------------
# cgroups / scheduling - Android 14 task profiles.
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_AUTOGROUP=y

# ---------------------------------------------------------------------------
# zram - a 4GB TV box running Android 14 needs swap.
# ---------------------------------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_SWAP=y
CONFIG_LZ4_COMPRESS=y

# ---------------------------------------------------------------------------
# HDMI-CEC - the framework side is android.hardware.tv.hdmi.cec AIDL, but it
# needs the kernel CEC adapter at /dev/cec0.
# ---------------------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CEC_SUPPORT=y
# CONFIG_MEDIA_CEC_RC needs RC_CORE and did not take. CEC works without the
# remote-control input bridge; the IR receiver is handled by lirc instead.
CONFIG_CEC_CORE=y
CONFIG_DRM_DW_HDMI_CEC=y

# ---------------------------------------------------------------------------
# Graphics: Mali-T860 is Midgard, not Bifrost.
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
# CONFIG_DRM_MALI_DISPLAY is not set
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_DEVFREQ=y
# CONFIG_MALI_MIDGARD_DVFS did not take; CONFIG_MALI_DEVFREQ above is the
# symbol this kernel actually uses for GPU frequency scaling.
CONFIG_MALI_EXPERT=y
CONFIG_MALI_DMA_FENCE=y
# CONFIG_MALI_BIFROST is not set

# Utgard (Mali-300/400/450) is a different GPU family entirely; the RK3399 has a
# Mali-T860, which is Midgard. kedge_defconfig builds both driver stacks, so every
# kernel build compiled a second, useless GPU driver and printed
#   grep: include/linux/mali/mali_utgard_uk_types.h: No such file or directory
# four times from its build-info script. Nothing on this board can use it and no
# userspace blob talks to it.
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set

# ---------------------------------------------------------------------------
# Media: Rockchip VPU for the Codec2 store.
# ---------------------------------------------------------------------------
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_RKVENC=y
CONFIG_ROCKCHIP_MPP_VDPU1=y
CONFIG_ROCKCHIP_MPP_VEPU1=y
CONFIG_ROCKCHIP_RGA2=y
# CONFIG_ROCKCHIP_IEP does not exist in this kernel and did not take.

# ---------------------------------------------------------------------------
# Connectivity: AP6398S (BCM4359) + Gigabit Ethernet.
# ---------------------------------------------------------------------------
# BCMDHD is a bool in this kernel, not a tristate: setting =m produced
# ".config: symbol value 'm' invalid for BCMDHD" and was dropped. kedge_defconfig
# already builds it in, which is kept. Because it is built in, init.edge1.rc must
# NOT insmod bcmdhd.ko - there is no module to load.
CONFIG_BCMDHD=y
# CONFIG_BCMDHD_SDIO, CONFIG_BCMDHD_PCIE and CONFIG_STA_ANDROID do not exist in
# this tree; the merge reported all three as not set and they are dropped.
CONFIG_CFG80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y

# ---------------------------------------------------------------------------
# Diagnostics. IKCONFIG lets VTS read the running config back out of
# /proc/config.gz, which is how the kernel config tests are scored.
# ---------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PROC_FS=y
