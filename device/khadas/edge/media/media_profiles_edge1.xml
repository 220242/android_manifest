<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE MediaSettings [
<!ELEMENT MediaSettings (CamcorderProfiles*, EncoderOutputFileFormat+, VideoEncoderCap+,
                         AudioEncoderCap+, VideoDecoderCap, AudioDecoderCap)>
<!ELEMENT CamcorderProfiles (EncoderProfile+, ImageEncoding+, ImageDecoding, Camera)>
<!ATTLIST CamcorderProfiles cameraId CDATA #REQUIRED>
<!ELEMENT EncoderProfile (Video, Audio)>
<!ATTLIST EncoderProfile quality CDATA #REQUIRED>
<!ATTLIST EncoderProfile fileFormat CDATA #REQUIRED>
<!ATTLIST EncoderProfile duration CDATA #REQUIRED>
<!ELEMENT Video EMPTY>
<!ATTLIST Video codec CDATA #REQUIRED>
<!ATTLIST Video bitRate CDATA #REQUIRED>
<!ATTLIST Video width CDATA #REQUIRED>
<!ATTLIST Video height CDATA #REQUIRED>
<!ATTLIST Video frameRate CDATA #REQUIRED>
<!ELEMENT Audio EMPTY>
<!ATTLIST Audio codec CDATA #REQUIRED>
<!ATTLIST Audio bitRate CDATA #REQUIRED>
<!ATTLIST Audio sampleRate CDATA #REQUIRED>
<!ATTLIST Audio channels (1|2) #REQUIRED>
<!ELEMENT ImageEncoding EMPTY>
<!ATTLIST ImageEncoding quality (90|80|70|60|50|40) #REQUIRED>
<!ELEMENT ImageDecoding EMPTY>
<!ATTLIST ImageDecoding memCap CDATA #REQUIRED>
<!ELEMENT Camera EMPTY>
<!ATTLIST Camera previewFrameWidth CDATA #REQUIRED>
<!ATTLIST Camera previewFrameHeight CDATA #REQUIRED>
<!ELEMENT EncoderOutputFileFormat EMPTY>
<!ATTLIST EncoderOutputFileFormat name (3gp|mp4) #REQUIRED>
<!ELEMENT VideoEncoderCap EMPTY>
<!ATTLIST VideoEncoderCap name (h264|h263|m4v) #REQUIRED>
<!ATTLIST VideoEncoderCap enabled (true|false) #REQUIRED>
<!ATTLIST VideoEncoderCap minBitRate CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap maxBitRate CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap minFrameWidth CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap maxFrameWidth CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap minFrameHeight CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap maxFrameHeight CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap minFrameRate CDATA #REQUIRED>
<!ATTLIST VideoEncoderCap maxFrameRate CDATA #REQUIRED>
<!ELEMENT AudioEncoderCap EMPTY>
<!ATTLIST AudioEncoderCap name (aac|heaac|aaceld|amrwb|amrnb) #REQUIRED>
<!ATTLIST AudioEncoderCap enabled (true|false) #REQUIRED>
<!ATTLIST AudioEncoderCap minBitRate CDATA #REQUIRED>
<!ATTLIST AudioEncoderCap maxBitRate CDATA #REQUIRED>
<!ATTLIST AudioEncoderCap minSampleRate CDATA #REQUIRED>
<!ATTLIST AudioEncoderCap maxSampleRate CDATA #REQUIRED>
<!ATTLIST AudioEncoderCap minChannels (1|2) #REQUIRED>
<!ATTLIST AudioEncoderCap maxChannels (1|2) #REQUIRED>
<!ELEMENT VideoDecoderCap EMPTY>
<!ATTLIST VideoDecoderCap name (wmv) #REQUIRED>
<!ATTLIST VideoDecoderCap enabled (true|false) #REQUIRED>
<!ELEMENT AudioDecoderCap EMPTY>
<!ATTLIST AudioDecoderCap name (wma) #REQUIRED>
<!ATTLIST AudioDecoderCap enabled (true|false) #REQUIRED>
]>
<!--
  Khadas Edge1 - media profiles.

  One CamcorderProfiles block, for a camera this TV box does not have. It is not
  optional: the first file this tree shipped had none, because
  android.hardware.camera is declared unavailable, and zygote aborted on every
  start while preloading android.media.CamcorderProfile -
    F MediaProfiles: frameworks/av/media/libmedia/MediaProfiles.cpp:794
      CHECK(cameraIds.size() > 0) failed.
  (MediaProfiles::initRequiredProfileRefs, tenth card). The block below is the
  shape AOSP's emulator ships: one ordinary profile and one time-lapse profile for
  camera 0, from which MediaProfiles derives the required low/high and
  time-lapse low/high profiles. Nothing records with it - there is no camera HAL -
  it only satisfies the parser.

  The encoder caps are declared because screen recording and Cast mirroring
  use the H.264 encoder without any camera involved.
-->
<MediaSettings>
    <CamcorderProfiles cameraId="0">
        <EncoderProfile quality="qvga" fileFormat="mp4" duration="60">
            <Video codec="h264" bitRate="384000" width="320" height="240" frameRate="30" />
            <Audio codec="aac" bitRate="96000" sampleRate="44100" channels="1" />
        </EncoderProfile>
        <EncoderProfile quality="timelapseqcif" fileFormat="mp4" duration="30">
            <Video codec="h264" bitRate="192000" width="176" height="144" frameRate="30" />
            <!-- audio is ignored for time-lapse, but the parser wants the element -->
            <Audio codec="aac" bitRate="96000" sampleRate="44100" channels="1" />
        </EncoderProfile>
        <ImageEncoding quality="90" />
        <ImageEncoding quality="80" />
        <ImageEncoding quality="70" />
        <ImageDecoding memCap="20000000" />
        <Camera previewFrameWidth="320" previewFrameHeight="240" />
    </CamcorderProfiles>

    <EncoderOutputFileFormat name="mp4" />
    <EncoderOutputFileFormat name="3gp" />

    <VideoEncoderCap name="h264" enabled="true"
        minBitRate="64000" maxBitRate="30000000"
        minFrameWidth="176" maxFrameWidth="1920"
        minFrameHeight="144" maxFrameHeight="1088"
        minFrameRate="15" maxFrameRate="30" />

    <AudioEncoderCap name="aac" enabled="true"
        minBitRate="8000" maxBitRate="320000"
        minSampleRate="8000" maxSampleRate="48000"
        minChannels="1" maxChannels="2" />

    <VideoDecoderCap name="wmv" enabled="false" />
    <AudioDecoderCap name="wma" enabled="false" />
</MediaSettings>
