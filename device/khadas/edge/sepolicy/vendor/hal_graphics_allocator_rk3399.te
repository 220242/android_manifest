# AIDL android.hardware.graphics.allocator-V2, Mali-T860 (Midgard) gralloc.
# Replaces the Android 10 passthrough allocator@2.0, which ran inside each
# client process and so needed no domain of its own. As an AIDL service it is
# now a real process and needs one.

type hal_graphics_allocator_rk3399, domain;
type hal_graphics_allocator_rk3399_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_graphics_allocator_rk3399, hal_graphics_allocator)
init_daemon_domain(hal_graphics_allocator_rk3399)

# Mali kernel driver: buffer allocation goes through the GPU device.
allow hal_graphics_allocator_rk3399 gpu_device:chr_file rw_file_perms;
# DRM dumb buffers for scanout-capable allocations.
allow hal_graphics_allocator_rk3399 graphics_device:chr_file rw_file_perms;
# ION/dma-heap for the VPU-shared and AFBC allocations.
allow hal_graphics_allocator_rk3399 dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_graphics_allocator_rk3399 dmabuf_system_secure_heap_device:chr_file r_file_perms;

get_prop(hal_graphics_allocator_rk3399, vendor_graphics_prop)
