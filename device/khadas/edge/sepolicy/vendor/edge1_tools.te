# Edge1 Tools (apps/Edge1Tools) is platform-signed and runs as the system user,
# system_app (it sets the sys.* / persist.sys.* properties of its performance modes
# and logs switch, which system_app may). Its performance overlay and mode screen
# read per-core load from /proc/stat, the clocks from cpufreq and devfreq, and the
# thermal zones. Up to card 22 it was platform_app; the rules stay for that.
allow platform_app proc_stat:file r_file_perms;
allow platform_app sysfs_devfreq:dir r_dir_perms;
allow platform_app sysfs_devfreq:lnk_file read;
allow platform_app sysfs_thermal:dir r_dir_perms;
allow platform_app sysfs_thermal:file r_file_perms;
allow platform_app sysfs_thermal:lnk_file read;

allow system_app proc_stat:file r_file_perms;
allow system_app sysfs_devfreq:dir r_dir_perms;
allow system_app sysfs_devfreq:lnk_file read;
allow system_app sysfs_gpu:dir r_dir_perms;
allow system_app sysfs_gpu:file r_file_perms;
allow system_app sysfs_devices_system_cpu:file r_file_perms;
allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:file r_file_perms;
allow system_app sysfs_thermal:lnk_file read;
