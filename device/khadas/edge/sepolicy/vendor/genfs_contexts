# Khadas Edge1 - sysfs labels.
#
# Needed because unlabelled sysfs defaults to sysfs:s0, which vendor domains
# cannot write. The Rockchip HALs that read most of these are gone; what remains
# is read by init, by the thermal and power HALs from AOSP, and by anything that
# looks at the GPU's devfreq state.
#
# Paths are mainline's. ff9a0000.gpu is still the GPU node - the address comes from
# the SoC, not the driver - but it is panfrost that binds to it now.

genfscon sysfs /devices/platform/ff9a0000.gpu                    u:object_r:sysfs_gpu:s0
genfscon sysfs /class/devfreq                                    u:object_r:sysfs_devfreq:s0
genfscon sysfs /devices/system/cpu/cpufreq                       u:object_r:sysfs_devices_system_cpu:s0
# The SD card controller, which is what vold walks. Two things were wrong with
# the line this replaces, "/devices/platform/fe380000.dwmmc/mmc_host":
# fe380000 is usb@fe380000, an EHCI controller, not an mmc one, and mainline
# names the node mmc@<address> where the BSP named it dwmmc@<address>. The three
# real controllers are fe310000 (sdio0, the Wi-Fi module), fe320000 (sdmmc, the
# card slot) and fe330000 (sdhci, the eMMC this boots from).
genfscon sysfs /devices/platform/fe320000.mmc/mmc_host           u:object_r:sysfs_mmc_host:s0
# /module/bcmdhd/parameters/firmware_path was labelled here so init could write
# it. brcmfmac has no such parameter: the kernel firmware loader finds the
# firmware by name under /vendor/firmware, so nothing writes a path at run time.
genfscon sysfs /devices/platform/ff940000.hdmi                   u:object_r:sysfs_hdmi:s0
# /class/backlight was labelled sysfs_leds here. This board has no backlight
# device - it drives HDMI, and the kernel fragment does not build
# BACKLIGHT_CLASS_DEVICE - so the directory never appears.
genfscon sysfs /class/thermal                                    u:object_r:sysfs_thermal:s0

# rockchip-drm's platform device. libdrm (drmGetDevice, in minigbm and Mesa) reads
# its uevent in every process that draws; as plain sysfs that was denied to all of
# them (cards 18-19). It is the display half of the GPU pair, so sysfs_gpu, which
# AOSP lets graphics clients read.
genfscon sysfs /devices/platform/display-subsystem               u:object_r:sysfs_gpu:s0

# The thermal zones themselves (/sys/class/thermal only holds links to them):
# the thermal service, the performance overlay and the bootwatch read them.
genfscon sysfs /devices/virtual/thermal                          u:object_r:sysfs_thermal:s0

# The USB PHYs' extcon devices, which system_server reads for cable state.
genfscon sysfs /devices/platform/ff770000.syscon/ff770000.syscon:usb2phy@e450/extcon u:object_r:sysfs_extcon:s0
genfscon sysfs /devices/platform/ff770000.syscon/ff770000.syscon:usb2phy@e460/extcon u:object_r:sysfs_extcon:s0

# Wakeup sources system_suspend reads statistics from: the PMIC on i2c4 and the
# power button. More may show up in misc.txt's /sys/class/wakeup listing.
genfscon sysfs /devices/platform/ff3d0000.i2c/i2c-4/4-001b/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/gpio-keys/wakeup                u:object_r:sysfs_wakeup:s0
