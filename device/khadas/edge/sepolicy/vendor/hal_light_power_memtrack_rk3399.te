# Small AIDL HALs sharing one policy file.
#   light@2.0    -> android.hardware.light-V2
#   power@1.0    -> android.hardware.power-V4
#   memtrack@1.0 -> android.hardware.memtrack-V1

type hal_light_rk3399, domain;
type hal_light_rk3399_exec, exec_type, vendor_file_type, file_type;
hal_server_domain(hal_light_rk3399, hal_light)
init_daemon_domain(hal_light_rk3399)
# Only the blue power LED and the backlight node exist on this board.
allow hal_light_rk3399 sysfs_leds:dir r_dir_perms;
allow hal_light_rk3399 sysfs_leds:file rw_file_perms;

type hal_power_rk3399, domain;
type hal_power_rk3399_exec, exec_type, vendor_file_type, file_type;
hal_server_domain(hal_power_rk3399, hal_power)
init_daemon_domain(hal_power_rk3399)
# Interactive/boost hints are applied to the A72 and A53 cpufreq policies and
# to the Mali devfreq governor.
allow hal_power_rk3399 sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_power_rk3399 sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_rk3399 sysfs_devfreq:dir r_dir_perms;
allow hal_power_rk3399 sysfs_devfreq:file rw_file_perms;
allow hal_power_rk3399 sysfs_gpu:dir r_dir_perms;
allow hal_power_rk3399 sysfs_gpu:file rw_file_perms;

type hal_memtrack_rk3399, domain;
type hal_memtrack_rk3399_exec, exec_type, vendor_file_type, file_type;
hal_server_domain(hal_memtrack_rk3399, hal_memtrack)
init_daemon_domain(hal_memtrack_rk3399)
# Per-process Mali allocation accounting.
allow hal_memtrack_rk3399 sysfs_gpu:dir r_dir_perms;
allow hal_memtrack_rk3399 sysfs_gpu:file r_file_perms;
