# Khadas Edge1 - vendor device node types.
#
# /dev/mali0 and /dev/dri/renderD128 are deliberately labelled with AOSP's
# existing gpu_device rather than a board-specific type: gpu_device already
# carries the app-domain access rules every GL client needs, and inventing a
# new type would mean re-granting all of them.

type mpp_device, dev_type;
type rga_device, dev_type;
type iep_device, dev_type;
type hdmi_cec_device, dev_type;
type lirc_device, dev_type;
